{"inject": [], "steps": [{"nav": "https://www.rednote.com/"}, {"wait": 9000}, {"label": "rednote 首页结构", "eval": "(()=>{var as=[...document.querySelectorAll(\"a[href]\")];var paths={};as.forEach(function(a){var h=a.getAttribute(\"href\")||\"\";var m=h.match(/^\\/([a-zA-Z\\-]+)\\//);if(m)paths[m[1]]=(paths[m[1]]||0)+1;});var st=window.__INITIAL_STATE__;return{url:location.href,title:document.title,hasState:!!st,stateKeys:st?Object.keys(st):null,paths:paths,noteItem:document.querySelectorAll(\"[class*=\\\"note-item\\\"]\").length,feeds:document.querySelectorAll(\"[class*=\\\"feeds\\\"]\").length,samples:as.slice(0,10).map(function(a){return a.getAttribute(\"href\");})};})()"}, {"shot": "shots/rednote.png"}]}